[firebase]
# Caminho relativo à pasta principal do projeto; a chave privada permanece no JSON.
project_id = "dia-dos-professores-4daed"
service_account_file = "dia-dos-professores-4daed-firebase-adminsdk-fbsvc-deb2fee28f.json"
# Obtenha a Web API Key em Firebase Console > Configurações do projeto > Geral.
api_key = "COLE_A_WEB_API_KEY_DO_FIREBASE"

[gemini]
api_key = "COLE_SUA_CHAVE_GEMINI"
model = "gemini-3.8-flash"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "GERE_UM_SEGREDO_LONGO_E_ALEATORIO"

[auth.google]
client_id = "CLIENT_ID_DO_GOOGLE"
client_secret = "CLIENT_SECRET_DO_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
